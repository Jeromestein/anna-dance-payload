# Local development: use the Supabase Session pooler on port 5432.
# Vercel Production and Preview must set this same variable to the Transaction
# pooler URL on port 6543. Use a direct or Session connection for migrations;
# do not run migrations through the Transaction pooler.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=generate-a-long-random-secret

# The same Supabase project hosts Payload, Storage, and student authentication.
# Public values support student login; the server-only secret lets Payload
# administrators manage student profiles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
CAL_WEBHOOK_SECRET=replace_with_a_random_webhook_secret
# Additional event types accepted alongside the official website booking catalog.
CAL_ALLOWED_EVENT_TYPE_SLUGS=trial-class-consultation,level-class,duet-class,solo-class-30min,solo-class

# Resend sends contact-form messages, Payload Staff password-reset emails, and
# new Student registration notifications.
# The sender must use a domain verified in the Resend account.
RESEND_API_KEY=re_your_server_only_api_key
RESEND_FROM_EMAIL="Anna Dance Academy <accounts@annadanceacademy.com>"
CONTACT_TO_EMAIL=annadanceacademy@gmail.com
STUDENT_REGISTRATION_NOTIFICATION_TO=annadanceacademy@gmail.com
# Optional separate recipient for website payment confirmations.
BILLING_NOTIFICATION_TO=annadanceacademy@gmail.com
# Sandbox billing notices require an explicit test inbox; never use a customer address.
BILLING_EMAIL_TEST_TO=

# Supabase Storage > S3 Configuration. These values must remain server-only.
S3_BUCKET=anna-dance-payload-poc
S3_ENDPOINT=https://[PROJECT_REF].storage.supabase.co/storage/v1/s3
S3_REGION=[PROJECT_REGION]
S3_ACCESS_KEY_ID=[SERVER_ONLY_ACCESS_KEY_ID]
S3_SECRET_ACCESS_KEY=[SERVER_ONLY_SECRET_ACCESS_KEY]

# Stripe: live merchant account for existing-payment verification.
# No NEXT_PUBLIC secrets. STRIPE_ACCOUNT_ID is the acct_ ID returned by /v1/account.
# Use .env.local for local values and restart the dev server after changes.
STRIPE_MODE=live
STRIPE_SECRET_KEY=rk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_ACCOUNT_ID=acct_replace_me
# Import/refresh work while false. Enable only for intended website Checkout.
STRIPE_LIVE_PAYMENTS_ENABLED=false
# Enable Admin refunds independently from website Checkout (requires refund write access).
STRIPE_LIVE_REFUNDS_ENABLED=false
# Local checkout returns here. Production must use the verified HTTPS website URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
